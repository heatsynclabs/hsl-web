#!/bin/sh
# Never name a language model as an author, co-author, contributor or reviewer.
# The person who ran the session is the author.
#
# Enable with: make hooks
# CI runs the same check over every commit in a pull request, and CI is the half
# that holds: a local hook runs only for somebody who enabled it.

set -eu

if grep -inE 'co-authored-by:[[:space:]]*(claude|gpt|copilot|gemini)|generated with \[?claude|claude-session:|assisted-by:|ai-generated:' "$1" >/dev/null; then
  echo "This commit message names a language model as an author. Remove that line." >&2
  exit 1
fi

if grep -qE '[—–]' "$1"; then
  echo "Em dashes and en dashes are not used here. Restructure the sentence." >&2
  exit 1
fi
