#!/bin/sh
# Rejects model attribution trailers and em dashes in commit messages.
# See CONTRIBUTING.md rules 1 and 11.

msg_file="$1"

if grep -qiE 'co-authored-by:[[:space:]]*claude|generated with claude|claude-session:|assisted-by:|ai-generated:|robot face' "$msg_file"; then
  echo "commit-msg: model attribution is not allowed in commit messages." >&2
  echo "The person who ran the session is the author. See CONTRIBUTING.md rule 1." >&2
  exit 1
fi

if grep -q '[—–]' "$msg_file"; then
  echo "commit-msg: em dashes and en dashes are not allowed. Restructure the sentence." >&2
  exit 1
fi

exit 0
