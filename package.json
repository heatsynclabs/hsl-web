{
  "name": "hsl-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HeatSync Labs members and door system",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @hsl/schema build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --no-warn-ignored && node tools/voice-check.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @hsl/schema build && docker compose up -d db api mail && pnpm -r --parallel dev",
    "db:generate": "pnpm --filter @hsl/schema db:generate",
    "db:migrate": "pnpm --filter @hsl/schema db:migrate"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
