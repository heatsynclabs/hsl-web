{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true,
    // The sources import each other with the .ts extension, which is what Node
    // needs when it strips types and what @hsl/schema already does. tsc rewrites
    // those to .js on the way out.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/test-support/**", "vitest.config.ts"]
}
