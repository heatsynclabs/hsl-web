{
  "extends": ["../../tsconfig.base.json", "@vue/tsconfig/tsconfig.dom.json"],
  "compilerOptions": {
    "noEmit": true,
    // Nothing is emitted: Vite compiles the sources. Declaration emit cannot be
    // combined with noEmit, and the same trade is made in packages/ui.
    "declaration": false,
    // @hsl/api-client and @hsl/schema import each other with .ts extensions.
    "allowImportingTsExtensions": true,
    // Gives the *?raw modules that @hsl/ui loads its marks with.
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "vitest.config.ts"]
}
