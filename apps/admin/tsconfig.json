{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Vite compiles the sources. Declaration emit would demand every SFC Props
    // interface be exported so it can name itself.
    "declaration": false,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // vite/client is what declares the .css side-effect import and the ?raw
    // query @hsl/ui reads its marks with.
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "vitest.config.ts"]
}
