# Copy to .env. `make secrets` does it and adds a database password.

# The database. PG_PASS is what compose starts Postgres with, and DATABASE_URL
# is what the scripts on your laptop connect with.
PG_PASS=
DATABASE_URL=postgres://hsl:@localhost:5432/hsl

# The public identity of this deployment. Anything https turns on secure
# cookies and makes SMTP_URL and the signing key required.
API_PORT=3000
ISSUER=http://localhost:3000
HSL_DOMAIN=localhost

# The apex domain, so one session covers every app on a subdomain. Empty gives
# a host-only cookie, which is what a laptop wants.
COOKIE_DOMAIN=

# Where an emailed reset link points. Defaults to ISSUER/reset.
RESET_URL=

# make keys prints these two.
SIGNING_KEY=
SIGNING_KEY_PUBLIC=

# Without it, reset links go to the API log instead of to a person.
SMTP_URL=
MAIL_FROM=

# Appended to a password before bcrypt verification, for the legacy hashes.
# Empty reduces that to plain bcrypt at no cost.
PEPPER=

# The doors this building has.
DOORS=front,rear

# The lab host, for compose.lab.yml.
API_URL=http://localhost:3000
SERVICE_TOKEN=
CONTROLLER_ID=openaccess
CONTROLLER_URL=http://10.0.0.x
CONTROLLER_PASSWORD=
DOOR_ORDER=front,rear
# openaccess for the board the lab owns, fake to run against the simulator.
CONTROLLER=openaccess
TICK_SECONDS=5
HEALTH_PORT=9000

# The one-time legacy import. A read-only restored copy, never the live system.
LEGACY_DATABASE_URL=
