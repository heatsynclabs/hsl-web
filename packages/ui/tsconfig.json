{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Nothing is emitted: apps compile the .vue sources through Vite. Declaration
    // emit would demand every SFC Props interface be exported to name itself.
    "declaration": false,
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vitest.config.ts"]
}
