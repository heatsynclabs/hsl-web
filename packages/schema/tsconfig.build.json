{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    // The sources import each other as './door.ts', which node's type stripping
    // needs during development. This rewrites those to './door.js' on the way
    // out so the emitted JavaScript resolves.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
